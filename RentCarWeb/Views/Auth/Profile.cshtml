@{
    ViewData["Title"] = "Profil Saya";
}

@model MsCustomer
@section Styles {
    <link rel="stylesheet" href="~/css/profile.css" />
}

<div class="profile-container">

    <h2>Profil Pengguna</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert-success">@TempData["Success"]</div>
    }

    @if (TempData["NeedLicense"] != null)
    {
        <div class="alert-warning">@TempData["NeedLicense"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert-error">@TempData["Error"]</div>
    }

    <form method="post">
        <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
        <div class="form-group">
            <label>Nama Lengkap</label>
            <input type="text" name="Name" value="@Model.Name" required />
        </div>

        <div class="form-group">
            <label>Email (Tidak bisa diubah)</label>
            <input type="email" value="@Model.Email" disabled />
        </div>

        <div class="form-group">
            <label>No. Telepon</label>
            <input type="text" name="Phone_Number" value="@Model.Phone_Number" required />
        </div>

        <div class="form-group">
            <label>Alamat</label>
            <textarea name="Address" required>@Model.Address</textarea>
        </div>

        <div class="form-group">
            <label>Nomor SIM</label>
            <input type="text" name="Driver_License_Number" value="@Model.Driver_License_Number" required />
        </div>
        <button type="submit" class="btn-save">Simpan Perubahan</button>

    </form>
</div>